{
  "name": "prahari-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:static": "tsc -b && vite build && node scripts/bundle-static-data.mjs",
    "preview": "vite preview --host",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "contracts": "json2ts ../contracts/schemas/object.schema.json -o src/api/types/object.d.ts && json2ts ../contracts/schemas/conjunction.schema.json -o src/api/types/conjunction.d.ts && json2ts ../contracts/schemas/catalog_status.schema.json -o src/api/types/catalog_status.d.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "plotly.js-dist-min": "^2.32.0",
    "react-plotly.js": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "json-schema-to-typescript": "^14.0.5",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
