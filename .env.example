# --- data source -----------------------------------------------------------
# mock  = serve contracts/fixtures, no network calls, no propagation. Default.
# live  = fetch CelesTrak, run SGP4, screen for real.
PRAHARI_DATA_SOURCE=mock

# JSON array of screened conjunction events the API loads at startup in mock
# mode. Validated against contracts/schemas/conjunction.schema.json; a
# mismatch aborts startup.
PRAHARI_EVENTS_PATH=contracts/fixtures/conjunctions.real.json

# --- database ----------------------------------------------------------------
POSTGRES_USER=prahari
POSTGRES_PASSWORD=prahari
POSTGRES_DB=prahari
DATABASE_URL=postgresql+asyncpg://prahari:prahari@db:5432/prahari

# --- cache / broker ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CONJUNCTION_STREAM_CHANNEL=prahari:conjunction_events

# --- api -----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# --- ingest / screening ---------------------------------------------------------
CELESTRAK_GP_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=tle
SCREENING_WINDOW_HOURS=72
SCREENING_INTERVAL_HOURS=6
COARSE_FILTER_THRESHOLD_KM=25
COMBINED_RADIUS_MARGIN_M=0

# --- web -------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1
